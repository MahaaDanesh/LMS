# PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/lms
DB_POOL_MIN=2
DB_POOL_MAX=20

# Flask
FLASK_SECRET_KEY=change-this-to-a-long-random-value

# Razorpay TEST MODE
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=

# Payment mode: demo (safe local testing), auto (Razorpay if keys exist, otherwise demo), or razorpay (real/test Razorpay)
PAYMENT_MODE=razorpay

# RazorpayX payouts (requires an activated RazorpayX account and configured source account)
RAZORPAYX_ACCOUNT_NUMBER=your_razorpayx_source_account_number
